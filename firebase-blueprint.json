{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role (ADMIN or FIELD_OFFICER)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "FIELD_OFFICER"] },
        "assignedOfficerId": { "type": "string" },
        "assignedArea": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "displayName", "role", "isActive"]
    },
    "Member": {
      "title": "Member",
      "description": "Cooperative society member details",
      "type": "object",
      "properties": {
        "memberSerial": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "address": { "type": "string" },
        "area": { "type": "string" },
        "joinDate": { "type": "string" },
        "weeklySavingsAmount": { "type": "number" },
        "assignedOfficerId": { "type": "string" },
        "assignedOfficerName": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["memberSerial", "name", "mobile", "weeklySavingsAmount", "isActive"]
    },
    "Officer": {
      "title": "Officer",
      "description": "Field Officer record with assigned members and areas",
      "type": "object",
      "properties": {
        "officerId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "assignedArea": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["officerId", "name", "email", "isActive"]
    },
    "Savings": {
      "title": "Savings",
      "description": "Weekly savings collection records per member and collection date",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "memberSerial": { "type": "string" },
        "collectionDate": { "type": "string" },
        "amount": { "type": "number" },
        "isPaid": { "type": "boolean" },
        "officerId": { "type": "string" },
        "officerName": { "type": "string" },
        "status": { "type": "string", "enum": ["APPROVED", "PENDING", "REJECTED"] },
        "createdBy": { "type": "string" },
        "approvedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["memberId", "collectionDate", "amount", "status"]
    },
    "Loan": {
      "title": "Loan",
      "description": "Loan distribution records",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "memberSerial": { "type": "string" },
        "loanDate": { "type": "string" },
        "principal": { "type": "number" },
        "interest": { "type": "number" },
        "totalPayable": { "type": "number" },
        "weeklyInstallment": { "type": "number" },
        "totalPaid": { "type": "number" },
        "remainingLoan": { "type": "number" },
        "nextInstallmentDate": { "type": "string" },
        "missedInstallments": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "PAID", "DEFAULTED"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["memberId", "principal", "interest", "totalPayable", "weeklyInstallment", "remainingLoan", "status"]
    },
    "LoanInstallment": {
      "title": "LoanInstallment",
      "description": "Installment collection against distributed loan",
      "type": "object",
      "properties": {
        "loanId": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "serialNumber": { "type": "string" },
        "installmentDate": { "type": "string" },
        "amount": { "type": "number" },
        "isMissed": { "type": "boolean" },
        "officerId": { "type": "string" },
        "status": { "type": "string", "enum": ["APPROVED", "PENDING", "REJECTED"] },
        "createdBy": { "type": "string" },
        "approvedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["loanId", "memberId", "installmentDate", "amount", "status"]
    },
    "Fine": {
      "title": "Fine",
      "description": "Separate 10 BDT weekly fine sheet records for missed savings or loan installments",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "memberSerial": { "type": "string" },
        "fineDate": { "type": "string" },
        "missedDate": { "type": "string" },
        "fineType": { "type": "string", "enum": ["SAVINGS", "LOAN"] },
        "amount": { "type": "number" },
        "isPaid": { "type": "boolean" },
        "paidDate": { "type": "string" },
        "referenceId": { "type": "string" },
        "officerId": { "type": "string" },
        "officerName": { "type": "string" },
        "status": { "type": "string", "enum": ["APPROVED", "PENDING", "REJECTED"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["memberId", "fineDate", "fineType", "amount", "isPaid"]
    },
    "FundLedger": {
      "title": "FundLedger",
      "description": "Deposit and withdrawal fund ledger entries",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "description": { "type": "string" },
        "moneyIn": { "type": "number" },
        "moneyOut": { "type": "number" },
        "balance": { "type": "number" },
        "referenceId": { "type": "string" },
        "type": { "type": "string", "enum": ["SAVINGS_COLLECTION", "LOAN_INSTALLMENT", "LOAN_DISBURSEMENT", "WITHDRAWAL", "EXPENSE", "DEPOSIT", "INITIAL"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["description", "moneyIn", "moneyOut", "balance", "type"]
    },
    "CollectionPeriod": {
      "title": "CollectionPeriod",
      "description": "Weekly collection date schedule metadata",
      "type": "object",
      "properties": {
        "dateStr": { "type": "string" },
        "monthYear": { "type": "string" },
        "isClosed": { "type": "boolean" },
        "totalSavings": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["dateStr", "monthYear"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit trail for transaction modifications and approvals",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "collection": { "type": "string" },
        "documentId": { "type": "string" },
        "oldValue": { "type": "string" },
        "newValue": { "type": "string" },
        "performedBy": { "type": "string" },
        "performedByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "collection", "performedBy"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Organization and application global configurations",
      "type": "object",
      "properties": {
        "orgName": { "type": "string" },
        "subtitle": { "type": "string" },
        "currency": { "type": "string" },
        "currentMonthHeading": { "type": "string" },
        "interestRatePercent": { "type": "number" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orgName", "currency"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles with role assignment"
    },
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Cooperative society members"
    },
    "/officers/{officerId}": {
      "schema": "Officer",
      "description": "Field officers directory"
    },
    "/savings/{savingsId}": {
      "schema": "Savings",
      "description": "Weekly savings records per member and date"
    },
    "/loans/{loanId}": {
      "schema": "Loan",
      "description": "Disbursed loans"
    },
    "/loanInstallments/{installmentId}": {
      "schema": "LoanInstallment",
      "description": "Loan installment payments"
    },
    "/fines/{fineId}": {
      "schema": "Fine",
      "description": "Separate fine records for missed savings and loan weeks"
    },
    "/fundLedger/{ledgerId}": {
      "schema": "FundLedger",
      "description": "Deposit & fund transaction ledger"
    },
    "/collectionPeriods/{periodId}": {
      "schema": "CollectionPeriod",
      "description": "Weekly collection date schedule"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "System audit logs"
    },
    "/appSettings/{settingId}": {
      "schema": "AppSettings",
      "description": "App settings configuration"
    }
  }
}
