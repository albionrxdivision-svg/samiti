<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="ekota_user_entered_data.xml" />
        <include domain="sharedpref" path="ekota_credentials_v1.xml" />
        <include domain="sharedpref" path="ekota_storage_prefs.xml" />
        <include domain="database" path="ekota_offline_sync.db" />
        <include domain="file" path="ekota_backups" />
        <exclude domain="sharedpref" path="ekota_fcm_prefs.xml" />
        <exclude domain="sharedpref" path="ekota_auth_session.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="ekota_user_entered_data.xml" />
        <include domain="sharedpref" path="ekota_credentials_v1.xml" />
        <include domain="sharedpref" path="ekota_storage_prefs.xml" />
        <include domain="database" path="ekota_offline_sync.db" />
        <include domain="file" path="ekota_backups" />
        <exclude domain="sharedpref" path="ekota_fcm_prefs.xml" />
        <exclude domain="sharedpref" path="ekota_auth_session.xml" />
    </device-transfer>
</data-extraction-rules>
